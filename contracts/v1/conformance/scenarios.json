        {
          "t_ms": 0,
          "type": "sample",
          "value_milli_celsius": 27000
        },
        {
          "t_ms": 10000,
          "type": "tick"
        }
      ],
      "expected_actions": [
        {
          "t_ms": 10000,
          "actuator": "fan",
          "state": "off"
