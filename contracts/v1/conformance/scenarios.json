{
  "status": "proposed_not_run",
  "artifact": "../examples/artifact.json",
  "clock": "virtual_monotonic_ms",
  "assumptions": [
    "actuator writes succeed",
    "initial state valid",
    "no initial cooldown except where noted",
    "test harness captures all timer deadlines; T12 requires freshness expiration to reset"
  ],
  "scenarios": [
    {
      "id": "T01",
      "description": "positive",
      "initial_fan": "off",
      "events": [
        {
          "t_ms": 0,
          "type": "sample",
          "value_milli_celsius": 31000
        },
        {
          "t_ms": 5000,
          "type": "sample",
          "value_milli_celsius": 31000
        },
        {
          "t_ms": 10000,
          "type": "tick"
        }
      ],
      "expected_actions": [
        {
          "t_ms": 10000,
          "actuator": "fan",
          "state": "on"
        }
      ]
    },
    {
      "id": "T02",
      "description": "strict boundary",
      "initial_fan": "off",
      "events": [
        {
          "t_ms": 0,
          "type": "sample",
          "value_milli_celsius": 30000
        },
        {
          "t_ms": 10000,
          "type": "tick"
        }
      ],
      "expected_actions": []
    },
    {
      "id": "T03",
      "description": "duration not reached",
      "initial_fan": "off",
      "events": [
        {
          "t_ms": 0,
          "type": "sample",
          "value_milli_celsius": 31000
        },
        {
          "t_ms": 9999,
          "type": "tick"
        }
      ],
      "expected_actions": []
    },
    {
      "id": "T04",
      "description": "condition reset",
      "initial_fan": "off",
      "events": [
        {
          "t_ms": 0,
          "type": "sample",
          "value_milli_celsius": 31000
        },
        {
          "t_ms": 5000,
          "type": "sample",
          "value_milli_celsius": 29000
        },
        {
          "t_ms": 6000,
          "type": "sample",
          "value_milli_celsius": 31000
        },
        {
          "t_ms": 10000,
          "type": "tick"
        },
        {
          "t_ms": 16000,
          "type": "tick"
        }
      ],
      "expected_actions": [
        {
          "t_ms": 16000,
          "actuator": "fan",
          "state": "on"
        }
      ]
    },
    {
