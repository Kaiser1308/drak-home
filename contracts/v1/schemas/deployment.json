{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drak.invalid/contracts/v1/deployment.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "deployment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "automation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "artifact_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "target_boot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "phase": {
          "const": "prepare"
        },
        "artifact": {
          "type": "object"
        }
      },
      "required": [
        "deployment_id",
        "automation_id",
        "version",
        "generation",
        "artifact_hash",
        "target_boot_id",
        "phase",
        "artifact"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "deployment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "automation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "artifact_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "target_boot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "phase": {
          "enum": [
            "commit",
            "abort"
          ]
        }
      },
      "required": [
        "deployment_id",
        "automation_id",
        "version",
        "generation",
        "artifact_hash",
        "target_boot_id",
        "phase"
      ],
      "additionalProperties": false
    }
  ]
}
