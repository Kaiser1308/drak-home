{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drak.invalid/contracts/v1/deployment-result.json",
  "type": "object",
  "properties": {
    "deployment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "automation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "ready",
        "active",
        "rejected",
        "aborted",
        "uncertain"
      ]
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "deployment_id",
    "automation_id",
    "generation",
    "artifact_hash",
    "status"
  ],
  "additionalProperties": false
}
